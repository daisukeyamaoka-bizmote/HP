---
import type { CollectionEntry } from 'astro:content';
import { getCategory } from '../data/categories';
import { fmtDate } from '../lib/format';

interface Props {
  article: CollectionEntry<'articles'>;
  authorName?: string;
  showByline?: boolean;
  showCategory?: boolean;
}
const { article, authorName, showByline = true, showCategory = true } = Astro.props;
const cat = getCategory(article.data.category);
---
<a href={`/articles/${article.id}/`} class="card">
  {showCategory && <span class="label">{cat.name}</span>}
  <h3>{article.data.title}</h3>
  <p>{article.data.description}</p>
  {showByline && <div class="byline" style="margin-top:10px;">{authorName}　{fmtDate(article.data.date)}</div>}
</a>
