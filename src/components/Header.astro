---
import { categories } from '../data/categories';
---
<div class="header-bar" id="header-bar">
  <div class="header-inner">
    <header class="site-header">
      <a href="/" class="logo" aria-label="bizmote トップページ">
        <img src="/images/RGB_black.png" alt="bizmote" width="150" height="40" />
      </a>
      <nav class="site-nav" aria-label="メインナビゲーション">
        {categories.map((cat) => <a href={`/category/${cat.slug}/`}>{cat.name}</a>)}
        <span class="nav-divider" aria-hidden="true"></span>
        <a href="/about/" class="nav-about">運営元について</a>
      </nav>
    </header>
    <div class="double-rule" aria-hidden="true"></div>
  </div>
</div>

<script>
  const bar = document.getElementById('header-bar');
  if (bar) {
    let lastY = window.scrollY;
    let ticking = false;
    const THRESHOLD = 80; // このpx以上スクロールしてから隠す(ページ最上部では常に表示)
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        if (y > lastY && y > THRESHOLD) {
          bar.classList.add('is-hidden'); // 下方向 → 隠す
        } else {
          bar.classList.remove('is-hidden'); // 上方向 → 出す
        }
        lastY = y <= 0 ? 0 : y;
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
