---
interface Props {
  title: string;
  size?: 'sm' | 'lg';
}
const { title, size = 'sm' } = Astro.props;
const cls = size === 'lg' ? 'share-btn lg' : 'share-btn';
const iconX = size === 'lg' ? 16 : 14;
const iconFB = size === 'lg' ? 17 : 15;
---
<button
  type="button"
  class={cls}
  title="Xでシェア"
  aria-label="Xでシェア"
  data-share="x"
  data-share-title={title}
>
  <svg width={iconX} height={iconX} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
</button>
<button type="button" class={cls} title="Facebookでシェア" aria-label="Facebookでシェア" data-share="fb">
  <svg width={iconFB} height={iconFB} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21.9v-8.4h2.8l.4-3.3h-3.2V8.1c0-1 .3-1.6 1.6-1.6h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.3v3.3h2.8v8.4z"></path></svg>
</button>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-share]');
    if (!btn) return;
    const url = encodeURIComponent(location.href.split('#')[0]);
    if (btn.dataset.share === 'x') {
      const text = encodeURIComponent(btn.dataset.shareTitle ?? document.title);
      window.open(`https://twitter.com/intent/tweet?text=${text}&url=${url}`, '_blank', 'width=560,height=460');
    } else {
      window.open(`https://www.facebook.com/sharer/sharer.php?u=${url}`, '_blank', 'width=560,height=580');
    }
  });
</script>
