      .grid-2 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: clamp(40px, 6vw, 96px);
        align-items: start;
      }
      .grid-2.wide-gap {
        gap: clamp(40px, 5vw, 80px);
      }
      .kicker {
        font-size: 0.75rem;
        letter-spacing: 0.35em;
        color: var(--sub);
        margin: 0 0 36px;
      }
      .accent-kicker {
        color: var(--acc);
        letter-spacing: 0.3em;
        font-weight: 500;
      }
      .h2 {
        font-family: 'Noto Serif JP', serif;
        font-weight: 600;
        font-size: clamp(1.75rem, 3.5vw, 2.9rem);
        line-height: 1.7;
        margin: 0 0 32px;
        text-wrap: pretty;
      }
      .h2-big {
        font-family: 'Noto Serif JP', serif;
        font-weight: 600;
        font-size: clamp(2rem, 4.5vw, 3.6rem);
        line-height: 1.65;
        margin: 0 0 72px;
        text-wrap: pretty;
      }
      .h3-large {
        font-family: 'Noto Serif JP', serif;
        font-weight: 600;
        font-size: clamp(1.375rem, 2.2vw, 1.875rem);
        line-height: 1.8;
        margin: 0;
        text-wrap: pretty;
      }
      .h3-serif {
        font-family: 'Noto Serif JP', serif;
        font-weight: 600;
        font-size: clamp(1.125rem, 1.6vw, 1.5rem);
        margin: 0 0 16px;
      }
      .body-text {
        font-size: clamp(1rem, 1.1vw, 1.125rem);
        line-height: 2;
        margin: 0 0 1.4em;
        max-width: 42em;
      }
      .body-text.last {
        margin-bottom: 0;
      }
      .body-block {
        max-width: 42em;
      }
      .small-text {
        font-size: 0.9375rem;
        line-height: 2;
        margin: 0;
      }
      .pull-quote {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
        line-height: 2.1;
        max-width: 40em;
        margin: 64px 0 24px;
        text-wrap: pretty;
      }
      .pull-quote.centered {
        margin-left: auto;
        margin-right: auto;
        text-align: center;
      }
      .center .pull-quote {
        margin-left: auto;
        margin-right: auto;
      }
      .source {
        font-size: 0.8125rem;
        color: var(--sub);
        line-height: 1.8;
        margin: 32px 0 0;
      }
      .source.bordered {
        margin-top: 56px;
        border-top: 1px solid var(--hair);
        padding-top: 16px;
      }
      .source.centered {
        text-align: center;
      }
      .note {
        font-size: 0.9375rem;
        line-height: 2;
        color: var(--sub);
        max-width: 46em;
        margin: 0;
      }
      .note.bordered {
        margin: 64px 0 96px;
        border-top: 1px solid var(--hair);
        padding-top: 24px;
      }
      .em-serif {
        font-family: 'Noto Serif JP', serif;
        font-size: 1.35em;
        font-weight: 600;
      }
      .label-en {
        font-size: 0.75rem;
        letter-spacing: 0.25em;
        color: var(--sub);
        margin: 0 0 12px;
      }
      .mb-sm {
        margin-bottom: 16px;
      }
      .mb-md {
        margin-bottom: 40px;
      }
      .mb-lg {
        margin-bottom: 64px;
      }
      .mb-xl {
        margin-bottom: 80px;
      }
      .center .kicker {
        text-align: center;
      }

      /* ---- 統計 ---- */
      .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: clamp(32px, 4vw, 56px);
        margin: 0 0 80px;
      }
      .stat-num {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(3rem, 6vw, 4.5rem);
        font-weight: 500;
        line-height: 1;
        margin: 0 0 20px;
      }
      .stat-num.accent {
        color: var(--acc);
      }
      .stat-unit {
        font-size: 0.5em;
      }
      .stat-label {
        font-size: 0.9375rem;
        line-height: 1.9;
        margin: 0;
      }

      /* ---- 図版 ---- */
      .figure {
        margin: 64px 0;
      }
      .figure.scroll-x {
        overflow-x: auto;
      }
      .figure-svg {
        width: 100%;
        display: block;
        margin: 0 auto;
      }
      .figure-caption {
        font-size: 0.8125rem;
        color: var(--sub);
        text-align: center;
        margin: 24px 0 0;
      }
      .q-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 24px;
        margin: 0 0 64px;
      }
      .q-item {
        font-size: clamp(1rem, 1.2vw, 1.1875rem);
        line-height: 2;
        margin: 0;
        border-top: 1px solid var(--hair-strong);
        padding-top: 20px;
      }

      /* ---- 信念 ---- */
      .belief-conclusion {
        border-top: 1px solid var(--hair);
        margin: 64px 0 0;
        padding: 48px 0 0;
      }
      .belief-statement {
        font-family: 'Noto Serif JP', serif;
        font-weight: 600;
        font-size: clamp(1.375rem, 2.4vw, 2rem);
        line-height: 1.9;
        margin: 0;
        text-wrap: pretty;
      }

      /* ---- 番号リスト ---- */
      .num-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .num-list li {
        display: grid;
        grid-template-columns: 64px 1fr;
        gap: 16px;
        align-items: baseline;
        padding: 24px 0;
        border-top: 1px solid var(--hair);
      }
      .num-list li:last-child {
        border-bottom: 1px solid var(--hair);
      }
      .num-list-no {
        font-family: 'Noto Serif JP', serif;
        font-size: 0.9375rem;
        color: var(--sub);
      }
      .num-list-label {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.125rem, 1.6vw, 1.5rem);
        font-weight: 500;
      }

      /* ---- 段組・枠線グリッド ---- */
      .col3-bordered,
      .col4-bordered {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 0;
        border-top: 1px solid var(--hair);
        border-bottom: 1px solid var(--hair);
        text-align: left;
      }
      .col4-bordered {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      }
      .col3-cell,
      .col4-cell {
        padding: 40px 32px;
      }
      .col3-cell:first-child,
      .col4-cell:first-child {
        padding-left: 0;
      }
      .col3-cell:last-child,
      .col4-cell:last-child {
        padding-right: 0;
      }
      .col3-cell + .col3-cell,
      .col4-cell + .col4-cell {
        border-left: 1px solid var(--hair);
      }
      @media (max-width: 767px) {
        .col3-cell + .col3-cell,
        .col4-cell + .col4-cell {
          border-left: none;
          border-top: 1px solid var(--hair);
        }
        .col3-cell,
        .col4-cell {
          padding-left: 0;
          padding-right: 0;
        }
      }
      .col4-no {
        font-family: 'Noto Serif JP', serif;
        font-size: 0.9375rem;
        color: var(--sub);
        margin: 0 0 12px;
      }
      .col4-title {
        font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
        font-weight: 700;
        margin: 0 0 10px;
      }
      .biz-name {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.375rem, 2vw, 1.75rem);
        font-weight: 600;
        margin: 0 0 8px;
      }
      .biz-tag {
        font-size: 0.8125rem;
        letter-spacing: 0.12em;
        color: var(--sub);
        margin: 0 0 24px;
      }

      /* ---- 行リスト（企業名など） ---- */
      .rows {
        border-top: 1px solid var(--hair);
      }
      .row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 8px 48px;
        align-items: baseline;
        padding: 32px 0;
        border-bottom: 1px solid var(--hair);
      }
      .row-name {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.375rem, 2.2vw, 1.875rem);
        font-weight: 500;
        margin: 0;
      }
      .row-desc {
        font-size: 0.9375rem;
        line-height: 1.9;
        margin: 0;
      }

      /* ---- 宣言 ---- */
      .declaration {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.25rem, 2.2vw, 1.875rem);
        line-height: 2;
        max-width: 32em;
        margin: 0 auto 96px;
        text-wrap: pretty;
      }
      .centered-block {
        margin-left: auto;
        margin-right: auto;
        margin-top: 64px;
        margin-bottom: 0;
        max-width: 40em;
      }

      /* ---- GTM 6つの問い ---- */
      .q6-list {
        list-style: none;
        margin: 0 0 96px;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 0 64px;
        border-top: 1px solid var(--hair);
      }
      .q6-list li {
        display: grid;
        grid-template-columns: 48px 1fr;
        gap: 12px;
        align-items: baseline;
        padding: 22px 0;
        border-bottom: 1px solid var(--hair);
        font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
      }
      .q6-no {
        font-family: 'Noto Serif JP', serif;
        font-size: 0.9375rem;
        color: var(--sub);
      }

      /* ---- 分断リスト ---- */
      .fault-grid {
        list-style: none;
        margin: 64px 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 24px 40px;
      }
      .fault-grid li {
        border-top: 1px solid var(--hair);
        padding-top: 16px;
      }
      .fault-name {
        font-weight: 500;
        display: block;
        margin-bottom: 6px;
      }
      .fault-desc {
        font-size: 0.9375rem;
        line-height: 1.9;
        color: var(--sub);
      }

      /* ---- アコーディオン ---- */
      .accordion {
        border-top: 1px solid rgba(26, 26, 26, 0.3);
      }
      .acc-item {
        border-bottom: 1px solid var(--hair);
      }
      .acc-btn {
        display: grid;
        grid-template-columns: 52px minmax(120px, 200px) 1fr 32px;
        gap: 16px;
        align-items: baseline;
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        padding: 26px 0;
        cursor: pointer;
        font-family: 'Noto Sans JP', sans-serif;
        color: var(--ink);
        transition: background 200ms;
      }
      .acc-btn:hover {
        background: rgba(26, 26, 26, 0.03);
      }
      .acc-no {
        font-family: 'Noto Serif JP', serif;
        font-size: 0.9375rem;
        color: var(--sub);
      }
      .acc-en {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.125rem, 1.6vw, 1.375rem);
        font-weight: 500;
      }
      .acc-ja {
        font-size: 0.9375rem;
        line-height: 1.9;
      }
      .acc-mark {
        font-size: 1.25rem;
        font-weight: 300;
        color: var(--sub);
        text-align: right;
      }
      .acc-detail {
        font-size: 0.9375rem;
        line-height: 2;
        color: var(--sub);
        margin: 0;
        padding: 0 32px 28px 68px;
      }
      @media (max-width: 640px) {
        .acc-btn {
          grid-template-columns: 40px 1fr 32px;
        }
        .acc-ja {
          grid-column: 2 / 3;
          grid-row: 2;
        }
        .acc-detail {
          padding-left: 56px;
        }
      }

      /* ---- 変える／変えない ---- */
      .list-heading {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.125rem, 1.6vw, 1.5rem);
        font-weight: 600;
        margin: 0 0 32px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--hair-strong);
      }
      .list-heading.accent-border {
        border-bottom-color: var(--acc);
      }
      .plain-list {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.9375rem;
        line-height: 2;
      }
      .plain-list li {
        padding: 18px 0;
        border-bottom: 1px solid var(--hair-soft);
      }
      .plain-list.narrow-list {
        max-width: 720px;
        border-top: 1px solid var(--hair);
        margin-bottom: 24px;
      }
      .dim {
        color: var(--sub);
      }
      .arrow {
        margin: 0 10px;
        color: var(--sub);
      }
      .line-list {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: clamp(1rem, 1.1vw, 1.125rem);
        line-height: 2;
      }
      .line-list li {
        padding: 14px 0;
        border-bottom: 1px solid var(--hair-soft);
      }
      .line-list.narrow-list {
        max-width: 720px;
        margin-bottom: 40px;
      }

      /* ---- 素養リスト ---- */
      .skill-list {
        list-style: none;
        margin: 0 0 64px;
        padding: 0;
        border-top: 1px solid var(--hair);
      }
      .skill-list li {
        display: grid;
        grid-template-columns: 52px minmax(160px, 290px) 1fr;
        gap: 16px;
        align-items: baseline;
        padding: 24px 0;
        border-bottom: 1px solid var(--hair);
      }
      @media (max-width: 640px) {
        .skill-list li {
          grid-template-columns: 40px 1fr;
        }
        .skill-desc {
          grid-column: 2 / 3;
        }
      }
      .skill-no {
        font-family: 'Noto Serif JP', serif;
        font-size: 0.9375rem;
        color: var(--sub);
      }
      .skill-name {
        font-weight: 700;
        font-size: clamp(1rem, 1.2vw, 1.125rem);
      }
      .skill-desc {
        font-size: 0.9375rem;
        line-height: 1.9;
      }

      /* ---- キャリアタイムライン ---- */
      .timeline {
        border-left: 1px solid rgba(26, 26, 26, 0.3);
        padding-left: clamp(28px, 4vw, 56px);
        display: grid;
        gap: 64px;
        max-width: 820px;
      }
      .timeline-item {
        position: relative;
      }
      .timeline-item::before {
        content: '';
        position: absolute;
        left: calc(-1 * clamp(28px, 4vw, 56px) - 5px);
        top: 12px;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--ink);
      }
      .timeline-item.accent-dot::before {
        background: var(--acc);
      }
      .timeline-title {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.25rem, 1.8vw, 1.625rem);
        font-weight: 600;
        margin: 0 0 20px;
      }
      .env-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 32px 48px;
        margin: 0 0 56px;
      }
      .env-cell {
        border-top: 1px solid var(--hair-strong);
        padding-top: 20px;
      }
      .env-title {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
        font-weight: 600;
        margin: 0 0 12px;
      }

      /* ---- MVV ---- */
      .mvv {
        display: grid;
        gap: 72px;
        margin: 72px 0 120px;
      }
      .mvv-statement {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.5rem, 3vw, 2.5rem);
        font-weight: 600;
        margin: 0;
      }
      .mvv-desc {
        font-size: clamp(1rem, 1.1vw, 1.125rem);
        line-height: 2.1;
        max-width: 34em;
        margin: 24px auto 0;
      }
      .mvv .label-en {
        letter-spacing: 0.3em;
        margin-bottom: 16px;
      }
      .values {
        display: grid;
        gap: 0;
        text-align: left;
        border-top: 1px solid var(--hair);
        margin-top: 56px;
      }
      .value {
        padding: 48px 0;
        border-bottom: 1px solid var(--hair);
      }
      .value-title {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.25rem, 1.9vw, 1.625rem);
        font-weight: 600;
        margin: 0 0 8px;
      }
      .value-sub {
        font-size: 0.9375rem;
        color: var(--sub);
        line-height: 1.9;
        margin: 0 0 20px;
      }
      .value .body-text {
        margin-bottom: 0;
      }

      /* ---- 時価総額 ---- */
      .cap-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 32px;
        margin: 0 0 20px;
      }
      .cap-cell {
        border-top: 1px solid var(--hair-strong);
        padding-top: 24px;
      }
      .cap-name {
        font-size: 0.9375rem;
        font-weight: 500;
        margin: 0 0 4px;
      }
      .cap-code {
        font-size: 0.75rem;
        color: var(--sub);
        margin: 0 0 20px;
      }
      .cap-value {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: 500;
        line-height: 1.2;
        margin: 0 0 8px;
      }
      .cap-unit {
        font-size: 0.5em;
      }
      .cap-bar-track {
        margin: 0 0 10px;
      }
      .cap-bar {
        height: 6px;
        background: var(--acc);
        width: 0;
        transition: width 1200ms var(--ease);
      }
      .cap-date {
        font-size: 0.75rem;
        color: var(--sub);
        margin: 0;
      }

      /* ---- 必要な4つ ---- */
      .need-grid {
        list-style: none;
        margin: 0 0 96px;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 40px;
      }
      .need-grid li {
        border-top: 1px solid var(--hair-strong);
        padding-top: 24px;
      }
      .need-no {
        font-family: 'Noto Serif JP', serif;
        font-size: 0.9375rem;
        color: var(--sub);
        margin: 0 0 14px;
      }
      .need-title {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
        font-weight: 600;
        margin: 0 0 12px;
      }

      /* ---- 成長3列 ---- */
      .grow-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 0;
        border-top: 1px solid var(--hair-strong);
        border-bottom: 1px solid var(--hair-strong);
        margin: 0 0 40px;
      }
      .grow-cell {
        padding: 36px 32px;
      }
      .grow-cell:first-child {
        padding-left: 0;
      }
      .grow-cell + .grow-cell {
        border-left: 1px solid var(--hair);
      }
      @media (max-width: 767px) {
        .grow-cell + .grow-cell {
          border-left: none;
          border-top: 1px solid var(--hair);
        }
        .grow-cell {
          padding-left: 0;
          padding-right: 0;
        }
        .grow-cell.inverted {
          padding-left: 24px;
          padding-right: 24px;
        }
      }
      .grow-cell .label-en {
        margin-bottom: 14px;
      }
      .grow-title {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(1.125rem, 1.6vw, 1.375rem);
        font-weight: 600;
        margin: 0 0 12px;
      }
      .grow-cell.inverted {
        background: var(--ink);
        color: var(--paper);
      }
      .grow-cell.inverted .label-en {
        color: rgba(247, 245, 242, 0.6);
      }
      .grow-cell.inverted .small-text {
        color: rgba(247, 245, 242, 0.8);
      }

      /* ---- bizPort ---- */
      .bizport-visual {
        width: 100%;
        height: 280px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--hair);
        background: repeating-linear-gradient(-45deg, transparent, transparent 14px, rgba(26, 26, 26, 0.04) 14px, rgba(26, 26, 26, 0.04) 15px);
      }
      .bizport-visual span {
        font-family: 'Noto Serif JP', serif;
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 600;
        color: transparent;
        -webkit-text-stroke: 1px rgba(26, 26, 26, 0.35);
      }
      .road-grid {
        list-style: none;
        margin: 0 0 56px;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 32px;
      }
      .road-grid li {
        border-top: 1px solid var(--hair-strong);
        padding-top: 20px;
      }

      /* ---- マーキー ---- */
      .marquee-band {
        overflow: hidden;
        white-space: nowrap;
        padding: 56px 0;
        border-top: 1px solid var(--hair-soft);
        border-bottom: 1px solid var(--hair-soft);
        position: relative;
        z-index: 1;
      }
      .marquee {
        display: inline-flex;
        animation: om-marquee 30s linear infinite;
        will-change: transform;
      }
      .marquee span {
        font-family: 'Noto Serif JP', serif;
        font-weight: 600;
        font-size: clamp(2.5rem, 6vw, 5rem);
        line-height: 1.2;
        color: transparent;
        -webkit-text-stroke: 1px rgba(26, 26, 26, 0.4);
        padding-right: 2em;
      }
      @keyframes om-marquee {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }

      /* ---- CTA ---- */
      .sec.cta {
        padding: clamp(120px, 16vh, 240px) clamp(24px, 6vw, 80px);
      }
      .cta-title {
        font-family: 'Noto Serif JP', serif;
        font-weight: 600;
        font-size: clamp(2rem, 5vw, 3.6rem);
        line-height: 1.6;
        margin: 0 0 40px;
      }
      .cta-lead {
        font-size: clamp(1rem, 1.1vw, 1.125rem);
        line-height: 2.1;
        max-width: 26em;
        margin: 0 auto 24px;
        text-align: left;
        text-wrap: pretty;
      }
      .cta-note {
        font-size: 0.875rem;
        letter-spacing: 0.06em;
        color: var(--sub);
        margin: 0 0 64px;
      }
      .cta-btn-wrap {
        display: flex;
        justify-content: center;
      }
      .cta-btn {
        display: inline-block;
        background: var(--acc);
        color: var(--paper);
        font-size: 1.0625rem;
        letter-spacing: 0.12em;
        padding: 20px 64px;
        transition:
          transform 300ms var(--ease),
          box-shadow 300ms;
      }
      .cta-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 16px 40px rgba(31, 58, 110, 0.35);
      }

      /* ---- フッター ---- */
      .footer {
        position: relative;
        z-index: 1;
        background: var(--ink);
        color: #b9b5af;
        padding: clamp(72px, 8vh, 120px) clamp(24px, 6vw, 80px) 48px;
      }
      .footer-logo {
        height: 52px;
        width: auto;
        display: block;
        margin: 0 0 8px -12px;
      }
      .footer-name {
        font-size: 0.8125rem;
        line-height: 1.9;
        margin: 0 0 48px;
      }
      .footer-copy {
        font-size: 0.75rem;
        line-height: 1.9;
        margin: 0;
        border-top: 1px solid rgba(247, 245, 242, 0.15);
        padding-top: 24px;
        color: #8a8680;
      }

      /* ---- スクロール演出 ---- */
      .reveal-init {
        opacity: 0;
        transform: translateY(24px);
      }
      .reveal-in {
        opacity: 1;
        transform: none;
        transition:
          opacity 800ms var(--ease),
          transform 800ms var(--ease);
      }
      .reveal-init [data-clip] {
        opacity: 0;
        transform: translateY(28px);
      }
      .reveal-in [data-clip] {
        opacity: 1;
        transform: none;
        transition:
          opacity 900ms var(--ease) 150ms,
          transform 900ms var(--ease) 150ms;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .marquee {
          animation: none;
        }
        .hero-scroll-line {
          animation: none;
        }
        .bglayer {
          transition: none;
        }
        .reveal-init {
          opacity: 1;
          transform: none;
        }
        .reveal-init [data-clip] {
          opacity: 1;
          transform: none;
        }
        .cap-bar {
          transition: none;
        }
      }
    </style>

    <script>
      const init = () => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const docEl = document.documentElement;

        // --- スクロール進捗バー / 背景色の移ろい / ナビ隠し / ヒーローパララックス / 章番号パララックス ---
        const progressEl = document.querySelector<HTMLElement>('[data-progress]');
        const bgLayer = document.querySelector<HTMLElement>('[data-bglayer]');
        const nav = document.querySelector<HTMLElement>('[data-nav]');
        const hero = document.querySelector<HTMLElement>('[data-hero]');
        const bgSections = Array.from(document.querySelectorAll<HTMLElement>('[data-bg]'));
        const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));

        let lastY = 0;
        let currentBg = '';
        let ticking = false;

        const onScroll = () => {
          const y = docEl.scrollTop || window.scrollY;
          const max = docEl.scrollHeight - docEl.clientHeight;

          if (progressEl) {
            progressEl.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
          }

          if (bgLayer) {
            let bg = '#F7F5F2';
            const half = window.innerHeight * 0.5;
            for (const el of bgSections) {
              if (el.getBoundingClientRect().top < half) bg = el.dataset.bg ?? bg;
            }
            if (bg !== currentBg) {
              currentBg = bg;
              bgLayer.style.background = bg;
            }
          }

          if (nav) {
            const goingDown = y > lastY;
            nav.classList.toggle('is-hidden', goingDown && y > 120);
            lastY = y;
          }

          if (!reduceMotion && hero) {
            hero.style.opacity = String(Math.max(0, 1 - y / (window.innerHeight * 0.7)));
            hero.style.transform = `translateY(${(y * 0.2).toFixed(1)}px)`;
          }

          if (!reduceMotion) {
            const vh = window.innerHeight;
            for (const el of parallaxEls) {
              const parent = el.parentElement;
              if (!parent) continue;
              const r = parent.getBoundingClientRect();
              if (r.bottom < -100 || r.top > vh + 100) continue;
              const ty = (r.top + r.height / 2 - vh / 2) * parseFloat(el.dataset.parallax ?? '0.2');
              el.style.transform = `translateY(calc(-50% + ${ty.toFixed(1)}px))`;
            }
          }

          ticking = false;
        };

        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(onScroll);
            }
          },
          { passive: true }
        );
        onScroll();

        // --- 出現アニメーション（reveal） ---
        const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
        if (!reduceMotion && 'IntersectionObserver' in window) {
          const below = revealEls.filter((el) => el.getBoundingClientRect().top >= window.innerHeight * 0.9);
          below.forEach((el) => el.classList.add('reveal-init'));
          const ro = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('reveal-in');
                ro.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -10% 0px' }
          );
          below.forEach((el) => ro.observe(el));
          // セーフティ: 6秒後に未表示が残っていたら強制表示
          setTimeout(() => {
            below.forEach((el) => el.classList.add('reveal-in'));
          }, 6000);
        }

        // --- 数値カウントアップ ---
        const counts = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));
        if (reduceMotion || !('IntersectionObserver' in window)) {
          counts.forEach((el) => {
            el.textContent = el.dataset.count ?? '';
          });
        } else {
          const co = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                co.unobserve(entry.target);
                const target = entry.target as HTMLElement;
                const goal = Number(target.dataset.count ?? '0');
                const started = performance.now();
                const tick = (now: number) => {
                  const k = Math.min(1, (now - started) / 1400);
                  target.textContent = String(Math.round(goal * (1 - Math.pow(1 - k, 3))));
                  if (k < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
              }
            },
            { threshold: 0.6 }
          );
          counts.forEach((el) => co.observe(el));
        }

        // --- 時価総額バーの伸長 ---
        const bars = Array.from(document.querySelectorAll<HTMLElement>('[data-bar]'));
        if (reduceMotion || !('IntersectionObserver' in window)) {
          bars.forEach((el) => {
            el.style.width = `${el.dataset.bar}%`;
          });
        } else {
          const bo = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                bo.unobserve(entry.target);
                const target = entry.target as HTMLElement;
                requestAnimationFrame(() => {
                  target.style.width = `${target.dataset.bar}%`;
                });
              }
            },
            { threshold: 0.4 }
          );
          bars.forEach((el) => bo.observe(el));
        }

        // --- GTM Method アコーディオン ---
        const accButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-acc]'));
        accButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const expanded = btn.getAttribute('aria-expanded') === 'true';
            accButtons.forEach((other) => {
              other.setAttribute('aria-expanded', 'false');
              const mark = other.querySelector('.acc-mark');
              if (mark) mark.textContent = '+';
              const panel = document.getElementById(other.getAttribute('aria-controls') ?? '');
              if (panel) panel.hidden = true;
            });
            if (!expanded) {
              btn.setAttribute('aria-expanded', 'true');
              const mark = btn.querySelector('.acc-mark');
              if (mark) mark.textContent = '−';
              const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
              if (panel) panel.hidden = false;
            }
          });
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init, { once: true });
      } else {
        init();
      }
    </script>
  </body>
</html>
