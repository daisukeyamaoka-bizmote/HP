---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedNews, newsTypeLabels } from '../../lib/content';
import { fmtDate } from '../../lib/format';

const news = await getPublishedNews();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'お知らせ', item: new URL('/news/', Astro.site).href },
  ],
};
---
<BaseLayout
  title="お知らせ"
  description="bizmote株式会社からのお知らせ・プレスリリースの一覧です。"
  schema={schema}
>
  <div style="padding:56px 0 32px 0;">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">トップ</a>　／　お知らせ
    </nav>
    <h1 class="page-title">お知らせ</h1>
  </div>

  <div style="display:flex; flex-direction:column; border-top:1px solid var(--ink); margin-bottom:80px;">
    {news.map((n) => (
      <a href={`/news/${n.id}/`} class="compact-row">
        <span class="date-num">{fmtDate(n.data.date)}</span>
        <span class="label">{newsTypeLabels[n.data.type]}</span>
        <span class="title">{n.data.title}</span>
      </a>
    ))}
  </div>
</BaseLayout>
