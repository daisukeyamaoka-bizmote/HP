---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site.json';
import { getPublishedNews, newsTypeLabels } from '../../lib/content';
import { fmtDate, toISODate } from '../../lib/format';

export async function getStaticPaths() {
  const news = await getPublishedNews();
  return news.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonical = new URL(`/news/${entry.id}/`, Astro.site).href;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: entry.data.title,
    datePublished: toISODate(entry.data.date),
    mainEntityOfPage: canonical,
    publisher: { '@type': 'Organization', name: site.companyName, url: site.siteUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'お知らせ', item: new URL('/news/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: canonical },
    ],
  },
];
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description ?? `${site.companyName}からのお知らせ。${entry.data.title}`}
  ogType="article"
  schema={schemas}
>
  <article class="reading" style="padding:56px 0 80px 0;">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">トップ</a>　／　<a href="/news/">お知らせ</a>
    </nav>
    <div style="display:flex; gap:14px; align-items:center; margin-bottom:16px;">
      <span class="date-num">
        <time datetime={toISODate(entry.data.date)}>{fmtDate(entry.data.date)}</time>
      </span>
      <span class="label">{newsTypeLabels[entry.data.type]}</span>
    </div>
    <h1 style="font-family:var(--serif); font-size:clamp(24px, 4vw, 32px); font-weight:700; line-height:1.6; margin:0 0 32px 0; text-wrap:pretty;">
      {entry.data.title}
    </h1>
    <div style="border-top:1px solid var(--line); padding-top:32px;" class="article-body">
      <Content />
    </div>
    <div style="border-top:1px solid var(--line-soft); margin-top:48px; padding-top:24px;">
      <a href="/news/" style="font-size:13px; color:var(--muted);">← お知らせ一覧へ戻る</a>
    </div>
  </article>
</BaseLayout>
