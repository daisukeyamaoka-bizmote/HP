---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import site from '../../data/site.json';
import { getCategory } from '../../data/categories';
import { getPublishedArticles, getAuthorsMap } from '../../lib/content';
import { fmtDate, toISODate, readingTimeFromBody } from '../../lib/format';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const category = getCategory(article.data.category);
const authors = await getAuthorsMap();
const author = authors.get(article.data.author);
const authorName = author?.data.name ?? article.data.author;

const allArticles = await getPublishedArticles();
const related = [
  ...allArticles.filter((a) => a.id !== article.id && a.data.category === article.data.category),
  ...allArticles.filter((a) => a.id !== article.id && a.data.category !== article.data.category),
].slice(0, 3);

const readingTime = article.data.readingTime ?? readingTimeFromBody(article.body ?? '');
const canonical = new URL(`/articles/${article.id}/`, Astro.site).href;

const schemas: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.data.title,
    description: article.data.description,
    datePublished: toISODate(article.data.date),
    dateModified: toISODate(article.data.updated ?? article.data.date),
    mainEntityOfPage: canonical,
    author: {
      '@type': 'Person',
      name: authorName,
      url: new URL(`/authors/${article.data.author}/`, Astro.site).href,
    },
    publisher: {
      '@type': 'Organization',
      name: site.companyName,
      logo: { '@type': 'ImageObject', url: `${site.siteUrl}/images/RGB_black.png` },
    },
    ...(article.data.image ? { image: new URL(article.data.image, Astro.site).href } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'トップ', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: category.name, item: new URL(`/category/${category.slug}/`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: article.data.title, item: canonical },
    ],
  },
];

if (article.data.faq?.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: article.data.faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}
---
<BaseLayout
  title={article.data.title}
  description={article.data.description}
  ogType="article"
  ogImage={article.data.image}
  schema={schemas}
>
  <article class="reading" style="padding:56px 0 48px 0;">
    <nav class="breadcrumb" style="display:flex; gap:12px; align-items:center;" aria-label="パンくずリスト">
      <a href="/">トップ</a><span>／</span>
      <a href={`/category/${category.slug}/`}>{category.name}</a>
    </nav>
    <h1 style="font-family:var(--serif); font-size:clamp(28px, 5vw, 42px); font-weight:700; line-height:1.5; margin:0 0 28px 0; letter-spacing:0.01em; text-wrap:pretty;">
      {article.data.title}
    </h1>
    <div style="display:flex; gap:14px; align-items:center; font-size:13px; color:var(--muted); padding-bottom:28px; border-bottom:1px solid var(--line); margin-bottom:36px; flex-wrap:wrap;">
      <div class="avatar" style="width:40px; height:40px;">
        {author?.data.avatar && <img src={author.data.avatar} alt="" />}
      </div>
      <a href={`/authors/${article.data.author}/`} style="font-weight:700; color:var(--ink);">{authorName}</a>
      {author?.data.note && <span style="color:var(--faint);">{author.data.note}</span>}
      <span style="width:1px; height:12px; background:var(--line);" aria-hidden="true"></span>
      <span>公開 <time datetime={toISODate(article.data.date)}>{fmtDate(article.data.date)}</time></span>
      {article.data.updated && (
        <span>更新 <time datetime={toISODate(article.data.updated)}>{fmtDate(article.data.updated)}</time></span>
      )}
      <span style="width:1px; height:12px; background:var(--line);" aria-hidden="true"></span>
      <span>読了 {readingTime}分</span>
      <div style="margin-left:auto; display:flex; gap:10px;">
        <ShareButtons title={`${article.data.title}｜${site.siteName}`} />
      </div>
    </div>

    {article.data.summary && (
      <div style="border-top:2px solid var(--ink); border-bottom:1px solid var(--line); padding:24px 4px; margin-bottom:40px;">
        <div class="label" style="margin-bottom:12px;">この記事の結論</div>
        <p style="font-size:15px; line-height:2; margin:0; color:var(--ink); text-wrap:pretty;">{article.data.summary}</p>
      </div>
    )}

    {article.data.image && (
      <div style="aspect-ratio:4/3; margin-bottom:40px; background:var(--fill); overflow:hidden;">
        <img src={article.data.image} alt="" style="width:100%; height:100%; object-fit:cover; display:block;" />
      </div>
    )}

    <div class="article-body">
      <Content />
    </div>

    <div style="display:flex; gap:14px; align-items:center; justify-content:center; margin-top:48px; padding:24px 0; border-top:1px solid var(--line-soft);">
      <span style="font-size:12px; letter-spacing:0.14em; color:var(--muted);">この記事をシェア</span>
      <ShareButtons title={`${article.data.title}｜${site.siteName}`} size="lg" />
    </div>

    <div style="border-top:1px solid var(--ink); padding-top:28px; display:flex; gap:20px; align-items:flex-start;">
      <div class="avatar" style="width:64px; height:64px;">
        {author?.data.avatar && <img src={author.data.avatar} alt="" />}
      </div>
      <div>
        <div class="label" style="margin-bottom:8px;">執筆・監修者</div>
        <a href={`/authors/${article.data.author}/`} style="display:block; font-family:var(--serif); font-size:18px; font-weight:700; margin-bottom:6px;">
          {authorName}
        </a>
        <p style="font-size:13px; line-height:1.9; color:var(--body2); margin:0;">
          {author?.data.bioShort ?? author?.data.bio}
        </p>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section style="border-top:1px solid var(--ink); padding:36px 0 64px 0;">
      <h2 style="font-family:var(--serif); font-size:22px; font-weight:700; margin:0 0 24px 0;">関連記事</h2>
      <div class="card-grid bm-g3">
        {related.map((r) => (
          <ArticleCard article={r} authorName={authors.get(r.data.author)?.data.name ?? r.data.author} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
