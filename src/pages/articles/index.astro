---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { getPublishedArticles, getAuthorsMap } from '../../lib/content';

const articles = await getPublishedArticles();
const authors = await getAuthorsMap();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: '記事一覧', item: new URL('/articles/', Astro.site).href },
  ],
};
---
<BaseLayout
  title="記事一覧"
  description="bizmote株式会社のメンバーが現場で確かめた知見を、実名で記録した記事の一覧です。新着順に全記事を掲載しています。"
  schema={schema}
>
  <div style="padding:56px 0 32px 0;">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">トップ</a>　／　記事一覧
    </nav>
    <h1 class="page-title">記事一覧</h1>
    <p style="font-size:13px; color:var(--muted); margin:12px 0 0 0;">新着順・全{articles.length}本</p>
  </div>

  <div class="article-rows" style="margin-bottom:80px;">
    {articles.map((article) => (
      <ArticleRow
        article={article}
        authorName={authors.get(article.data.author)?.data.name ?? article.data.author}
        showBadge
      />
    ))}
  </div>
</BaseLayout>
