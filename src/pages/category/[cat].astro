---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { categories, getCategory } from '../../data/categories';
import { getPublishedArticles, getAuthorsMap } from '../../lib/content';

export async function getStaticPaths() {
  return categories.map((c) => ({ params: { cat: c.slug } }));
}

const { cat } = Astro.params;
const category = getCategory(cat);
const articles = (await getPublishedArticles()).filter((a) => a.data.category === cat);
const authors = await getAuthorsMap();
const otherCategories = categories.filter((c) => c.slug !== cat);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: '記事一覧', item: new URL('/articles/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: category.name, item: new URL(`/category/${cat}/`, Astro.site).href },
  ],
};
---
<BaseLayout title={`${category.name}の記事一覧`} description={category.description} schema={schema}>
  <div style="padding:56px 0 32px 0;">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">トップ</a>　／　<a href="/articles/">記事一覧</a>　／　{category.name}
    </nav>
    <div class="eyebrow" style="margin-bottom:14px;">カテゴリ</div>
    <h1 class="page-title" style="margin-bottom:16px;">{category.name}</h1>
    <p style="font-size:14px; line-height:2; color:var(--ink-soft); margin:0; max-width:44em; text-wrap:pretty;">
      {category.description}
    </p>
  </div>

  <div class="article-rows" style="margin-bottom:56px;">
    {articles.map((article) => (
      <ArticleRow article={article} authorName={authors.get(article.data.author)?.data.name ?? article.data.author} />
    ))}
  </div>

  <div style="border-top:1px solid var(--line-soft); padding:24px 0 72px 0; display:flex; gap:28px; align-items:baseline; flex-wrap:wrap;">
    <span style="font-size:12px; color:var(--ink-sub);">ほかのカテゴリ</span>
    {otherCategories.map((c) => (
      <a href={`/category/${c.slug}/`} style="font-size:14px; font-family:var(--serif); font-weight:600;">{c.name}</a>
    ))}
  </div>
</BaseLayout>
