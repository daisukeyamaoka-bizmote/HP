---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleRow from '../components/ArticleRow.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EmptyNote from '../components/EmptyNote.astro';
import site from '../data/site.json';
import { categories, getCategory } from '../data/categories';
import { getPublishedArticles } from '../lib/content';

const articles = await getPublishedArticles();
const featured = articles[0];
const latest = articles.slice(1, 4);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.siteName,
  url: site.siteUrl,
  description: site.description,
  publisher: { '@type': 'Organization', name: site.companyName, url: site.siteUrl },
};
---
<BaseLayout schema={schema}>
  {featured && (
    <section class="fade-up" style="padding:48px 0 56px 0;">
      <a href={`/articles/${featured.id}/`} class="hero-feature">
        {featured.data.image && (
          <div class="hero-feature-media"><img src={featured.data.image} alt="" /></div>
        )}
        <span class="label" style="display:block; margin-bottom:16px;">
          {getCategory(featured.data.category).name}
        </span>
        <h1 class="hero-feature-title">{featured.data.title}</h1>
        <p class="hero-feature-lead">{featured.data.description}</p>
      </a>
    </section>
  )}

  <section class="fade-up" style="padding:0 0 48px 0;">
    <div class="section-head" style="display:flex; justify-content:space-between; align-items:baseline; gap:16px; margin-bottom:4px;">
      <h2 class="section-title">新着</h2>
      <a href="/articles/" style="font-size:13px; color:var(--muted);">記事一覧へ →</a>
    </div>
    <div style="display:flex; flex-direction:column;">
      {latest.map((article) => (
        <ArticleRow article={article} showBadge showByline={false} />
      ))}
      {articles.length === 0 && (
        <EmptyNote text="記事は準備中です。公開まで、運営元と専門領域についてはこちらをご覧ください。" />
      )}
    </div>
    {articles.length === 0 && (
      <p style="font-size:14px; margin:24px 0 0 0; display:flex; gap:28px; flex-wrap:wrap;">
        <a href="/about/">運営元について</a>
        <a href="/services/">サービス</a>
        <a href="/culturedeck/">カルチャーデック</a>
      </p>
    )}
  </section>

  {categories.map((cat) => {
    const catArticles = articles.filter((a) => a.data.category === cat.slug).slice(0, 3);
    if (catArticles.length === 0) return null;
    return (
      <section id={cat.anchor} class="fade-up" style="padding:0 0 48px 0;">
        <div class="section-head" style="margin-bottom:24px;">
          <div style="display:flex; justify-content:space-between; align-items:baseline; gap:16px; flex-wrap:wrap;">
            <h2 class="section-title">{cat.name}</h2>
            <a href={`/category/${cat.slug}/`} style="font-size:13px; color:var(--muted);">すべて見る →</a>
          </div>
          <p style="font-size:13px; line-height:1.9; color:var(--muted); margin:10px 0 0 0; max-width:36em; text-wrap:pretty;">
            {cat.description}
          </p>
        </div>
        <div class="card-grid bm-g3">
          {catArticles.map((a) => (
            <ArticleCard article={a} showByline={false} showCategory={false} />
          ))}
        </div>
      </section>
    );
  })}

</BaseLayout>

<script>
  const targets = document.querySelectorAll('.fade-up');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) {
    targets.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.08 }
    );
    targets.forEach((el) => io.observe(el));
  }
</script>
